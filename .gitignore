*.db-wal
*.db-shm
*.sqlite
*.sqlite3
nsm.db
**/nsm.db

# IDE & Editor Configurations
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/

# Eclipse / VS Code Java Language Server (JDT)
.project
.classpath
.settings/
.factorypath

# NetBeans
nbproject/
nb-configuration.xml

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Temporary Files, Logs & Crash Dumps
*.log
*.tmp
hs_err_pid*
replay_pid*

